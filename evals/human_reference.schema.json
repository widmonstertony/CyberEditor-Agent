{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybereditor-agent.local/schemas/human_reference.schema.json",
  "title": "CyberEditor human reference timeline",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "clips"],
  "properties": {
    "schema_version": {"type": "string"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "target_duration_sec": {"type": "number", "exclusiveMinimum": 0},
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["clip_id", "cut_in_sec", "cut_out_sec"],
        "anyOf": [
          {"required": ["source_id"]},
          {"required": ["asset_id"]},
          {"required": ["file_name"]},
          {"required": ["source_file"]},
          {"required": ["proxy_file_name"]}
        ],
        "properties": {
          "clip_id": {"type": ["string", "integer"]},
          "source_id": {"type": "string", "minLength": 1},
          "asset_id": {"type": "string", "minLength": 1},
          "file_name": {"type": "string", "minLength": 1},
          "source_file": {"type": "string", "minLength": 1},
          "proxy_file_name": {"type": "string", "minLength": 1},
          "cut_in_sec": {"type": "number", "minimum": 0},
          "cut_out_sec": {"type": "number", "exclusiveMinimum": 0},
          "editor_note": {"type": "string"}
        }
      }
    }
  }
}
